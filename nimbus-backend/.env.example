PORT=5000

# MongoDB (auth + activity history)
MONGO_URI=

# JWT
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# SMTP (Gmail app password) - OTP + outgoing email
EMAIL_USER=
EMAIL_PASS=

# AI provider switching (see src/services/ai)
ACTIVE_TEXT_PROVIDER=gemini            # gemini | claude | mock
ACTIVE_IMAGE_PROVIDER=huggingface      # huggingface | gemini-image | imagen | replicate | pollinations | mock
# Providers a client may request via req.body.textProvider / imageProvider (default: only the active one)
ALLOWED_TEXT_PROVIDERS=
ALLOWED_IMAGE_PROVIDERS=

# Provider keys
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
HF_API_KEY=                            # HUGGINGFACE_API_KEY / HF_TOKEN also accepted
POLLINATIONS_API_KEY=
REPLICATE_API_TOKEN=

# Optional model overrides
GEMINI_TEXT_MODEL=gemini-2.5-flash
CLAUDE_TEXT_MODEL=claude-sonnet-5-5
HF_IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
IMAGEN_MODEL=imagen-4.0-generate-001
REPLICATE_IMAGE_MODEL=black-forest-labs/flux-schnell

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Supabase (RAG, Phase 4) - server-side only, never expose to the frontend
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Automatic failover when the active provider fails (comma-separated, tried in order)
IMAGE_FALLBACK_PROVIDERS=
TEXT_FALLBACK_PROVIDERS=

# RAG
RAG_ADMIN_EMAILS=            # comma-separated emails allowed to add global (shared) knowledge
EMBEDDING_MODEL=gemini-embedding-001
RATE_LIMIT_PER_MIN=30
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3005
RAG_MIN_SIMILARITY=0.6
